{
  "cloakbrowser": {
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/broker.mjs"],
    "env": {
      "STEALTH_ENGINE": "${user_config.browser_engine}",
      "STEALTH_TOOL_PROFILE": "${user_config.tool_profile}",
      "STEALTH_ACCOUNT": "${user_config.account}",
      "CLOAK_PLAYWRIGHT_MCP_PACKAGE": "cloakbrowser-mcp@1.15.1",
      "CAMOUFOX_MCP_PACKAGE": "camoufox-playwright-mcp==0.1.5",
      "CAMOUFOX_BROWSER_BUILD": "v156.0.1-beta.39",
      "CAMOUFOX_NATIVE_PACKAGE": "mcp-camoufox==0.4.5",
      "CAMOUFOX_NATIVE_BROWSER_BUILD": "156.0.1-beta.39",
      "CAMOUFOX_PROFILE": "${user_config.camoufox_profile}",
      "CAMOUFOX_DATA_DIR": "${user_config.camoufox_data_dir}",
      "CAMOUFOX_DAEMON": "false",
      "KAMELEO_PROFILE_ID": "${user_config.kameleo_profile_id}",
      "KAMELEO_ENDPOINT": "${user_config.kameleo_endpoint}",
      "CLOAK_TOOL_GROUP_VISION": "${user_config.tools_vision}",
      "CLOAK_TOOL_GROUP_PDF": "${user_config.tools_pdf}",
      "CLOAK_TOOL_GROUP_DEVTOOLS": "${user_config.tools_devtools}",
      "CLOAK_TOOL_GROUP_STORAGE": "${user_config.tools_storage}",
      "CLOAK_TOOL_GROUP_NETWORK": "${user_config.tools_network}",
      "CLOAK_TOOL_GROUP_TESTING": "${user_config.tools_testing}",
      "CLOAK_TOOL_GROUP_CONFIG": "${user_config.tools_config}",
      "CLOAK_DISABLED_TOOLS": "${user_config.disabled_tools}",
      "PLAYWRIGHT_MCP_HEADLESS": "${user_config.headless}",
      "PLAYWRIGHT_MCP_BROWSER_ENGINE": "${user_config.browser_engine}",
      "CLOAK_PLAYWRIGHT_MCP_HUMANIZE": "${user_config.humanize}",
      "CLOAK_PLAYWRIGHT_MCP_CONSOLE_FALLBACK": "false",
      "CLOAK_PLAYWRIGHT_MCP_HUMAN_PRESET": "${user_config.human_preset}",
      "CLOAK_PLAYWRIGHT_MCP_RELEASE_CHANNEL": "${user_config.release_channel}",
      "CLOAK_PLAYWRIGHT_MCP_GEOIP_PROXY_MATCH": "${user_config.geoip_proxy_match}",
      "PLAYWRIGHT_MCP_USER_DATA_DIR": "${user_config.profile_dir}",
      "PLAYWRIGHT_MCP_PROXY_SERVER": "${user_config.proxy_server}",
      "PLAYWRIGHT_MCP_PROXY_BYPASS": "${user_config.proxy_bypass}",
      "CLOAKBROWSER_LICENSE_KEY": "${user_config.licence_key}",
      "CLOAKBROWSER_VERSION": "${user_config.engine_version}",
      "PLAYWRIGHT_MCP_OUTPUT_DIR": "${user_config.output_dir}"
    }
  }
}
